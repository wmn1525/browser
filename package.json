{
  "name": "imrun-fingerprint-browser",
  "version": "0.3.9",
  "private": true,
  "description": "ImRun 指纹浏览器  - 玩具",
  "main": "out/main/main.js",
  "scripts": {
    "build": "electron-vite build",
    "dev": "node scripts/run-electron-vite.cjs dev",
    "dist:mac-arm64": "npm run build && electron-builder --mac --arm64",
    "dist:mac-x64": "npm run build && electron-builder --mac --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "start": "node scripts/run-electron-vite.cjs preview",
    "test:antd-ui": "node scripts/test-antd-ui-replacement.cjs",
    "test:profile-table-ui": "node scripts/test-profile-table-ui.cjs",
    "test:topbar-ui": "node scripts/test-topbar-ui.cjs",
    "test:managed-extensions": "node scripts/test-managed-extension-service.cjs && node scripts/test-managed-extension-profile.cjs && node scripts/test-managed-extension-ui.cjs",
    "test:open-api": "node scripts/test-open-api-service.cjs && node scripts/test-open-api-ui.cjs",
    "test:automation": "node scripts/test-window-sync-service.cjs && node scripts/test-automation-subpages-ui.cjs",
    "test:settings-center": "node scripts/test-settings-center.cjs",
    "test:recycle-bin": "node scripts/test-recycle-bin-invariants.cjs",
    "test:release-publish": "node scripts/test-release-publish-config.cjs",
    "test:r2-upload": "node scripts/test-r2-upload.cjs",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@aitofy/browser-profiles": "^0.2.12",
    "adm-zip": "^0.5.18",
    "antd": "^6.5.0",
    "chrome-remote-interface": "^0.33.3",
    "electron-updater": "^6.8.9",
    "find-process": "^2.1.1",
    "lucide-react": "^0.468.0",
    "proxy-chain": "^2.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rebrowser-puppeteer-core": "^24.8.1",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.0.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vite": "^7.3.6"
  },
  "build": {
    "appId": "com.imrun.browser",
    "productName": "ImRun Browser",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "generic",
      "url": "https://browser.im-run.com/publish/"
    }
  }
}
